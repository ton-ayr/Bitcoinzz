# =====================================================================
# API (cd backend && npm run dev)
# Use este arquivo para rodar a API sem Docker.
#
# Como usar:  cp .env.example .env   (dentro da pasta backend/)
# O .env não vai para o git. Em produção (Render), estes valores ficam no painel.
# =====================================================================

# --- Obrigatório -----------------------------------------------------

# Conexão com o MongoDB (precisa ser replica set; o Atlas M0 é).
# Atlas > Database > Connect > Drivers: cole a string INTEIRA, já com a senha real e sem os <...>.
# Seu IP precisa estar liberado em Atlas > Security > Network Access.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Segredo que assina os logins (JWT), com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Opcional: e-mail real pela Mailjet ------------------------------
# Preencha as três juntas ou deixe as três vazias (os e-mails aparecem só no log da API).

# Mailjet > Account settings > API Key Management: API Key (pública) e Secret Key (privada).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# E-mail validado em Mailjet > Account settings > Senders & Domains (só o endereço).
MAIL_FROM_EMAIL=
# Nome que aparece como remetente.
MAIL_FROM_NAME=Bitcoinzz

# --- Opcional: já vêm com valores padrão ------------------------------

# development | test | production
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Duração da sessão: número + s, m, h ou d (ex.: 8h, 30m).
JWT_EXPIRES_IN=8h
# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000
# Cotação: API pública v4 do Mercado Bitcoin e cache em segundos (1 a 60).
QUOTE_API_URL=https://api.mercadobitcoin.net/api/v4
QUOTE_CACHE_TTL_SECONDS=10
