# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Conexão com o MongoDB. Substitua a linha INTEIRA pela string do Atlas
# (Database > Connect > Drivers), já com usuário e senha reais. Não deixe os <...>.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Segredo do JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000

# Cotação: API pública v4 do Mercado Bitcoin e cache em segundos (1 a 60)
QUOTE_API_URL=https://api.mercadobitcoin.net/api/v4
QUOTE_CACHE_TTL_SECONDS=10

# E-mail via SMTP do Brevo (grátis, 300/dia). Deixe SMTP_HOST vazio para só logar os e-mails.
# Brevo: Settings > SMTP & API > aba SMTP (use a "SMTP key", não a API key).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Precisa ser um remetente verificado no Brevo (Senders, Domains & Dedicated IPs).
MAIL_FROM="Bitcoinzz <seu-email-verificado@exemplo.com>"
