# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Conexão com o MongoDB (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Segredo do JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000
