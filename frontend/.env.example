# =====================================================================
# ADMIN (cd frontend && npm run dev)
# Use este arquivo para rodar o admin sem Docker.
#
# Como usar:  cp .env.example .env.local   (dentro da pasta frontend/)
# O .env.local não vai para o git. Em produção (Vercel), o valor fica no painel.
# =====================================================================

# Endereço da API. Fica só no servidor do Next: o navegador nunca vê.
# Local: http://localhost:3333 · Produção: URL do Render, com https e sem barra no final.
API_URL=http://localhost:3333
