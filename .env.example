# Variáveis do Docker Compose. Copie para .env (na raiz) e preencha:
#   cp .env.example .env
# O .env não vai para o git.

# Obrigatório. Segredo que assina os logins (JWT), com pelo menos 32 caracteres. Gere com:
#   openssl rand -hex 32
#   ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: e-mail real pelo SMTP do Brevo. Vazio = os e-mails aparecem em `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Precisa ser um remetente verificado no Brevo.
MAIL_FROM="Bitcoinzz <seu-email-verificado@exemplo.com>"
